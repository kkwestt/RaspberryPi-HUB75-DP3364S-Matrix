// Copy to include/secrets.h and fill in. secrets.h is not committed.
// Everything here is optional.
#pragma once

// Wi-Fi used until another network is saved on the web page
#define WIFI_SSID "your-wifi"
#define WIFI_PASSWORD "your-password"

// The setup access point ESP32S3+HUB75 is open on purpose, so it has no
// password here.

// Password for firmware updates (/update page, user "admin") and /pintest.
// Only used when WEB_PASSWORD is 1 in src/config.h; it is 0 by default.
#define OTA_PASSWORD "change-me"
