+// Number of scan rows driven on A-E and number of PWM groups (REG03 + 1) for
+// the DP3265S-style ROW scan. The DP3265S 64x32 panel is 1/8 scan; related
+// Depuw chips such as DP3364S on 128x64 panels run 1/32 scan
+// (SPWM_DP3265S_SCAN_ROWS=32 together with REG02=0x021F).
+int spwm_get_dp3265s_scan_rows() {
+  static int spwm_rows = -1;
+  if (spwm_rows < 0) {
+    int spwm_env_value = 0;
+    spwm_rows = 8;
+    if (spwm_parse_env_int("SPWM_DP3265S_SCAN_ROWS", &spwm_env_value) &&
+        spwm_env_value >= 1 && spwm_env_value <= 64) {
+      spwm_rows = spwm_env_value;
+    }
+  }
+  return spwm_rows;
+}
+
+int spwm_get_dp3265s_groups() {
+  static int spwm_groups = -1;
+  if (spwm_groups < 0) {
+    int spwm_env_value = 0;
+    spwm_groups = 64;
+    if (spwm_parse_env_int("SPWM_DP3265S_GROUPS", &spwm_env_value) &&
+        spwm_env_value >= 1 && spwm_env_value <= 128) {
+      spwm_groups = spwm_env_value;
+    }
+  }
+  return spwm_groups;
+}
+
 int spwm_get_dp3265s_vsync_mode() {
   static bool spwm_loaded = false;
   static int spwm_vsync_mode = 2;  // 0=off, 1=first data latch, 2=pre-upload
@@ -434,8 +464,9 @@ class SPWM_Display_Scan_Thread : public Thread {
