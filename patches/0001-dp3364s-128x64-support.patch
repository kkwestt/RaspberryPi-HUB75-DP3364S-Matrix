@@ -3011,6 +3059,32 @@ void spwm_dump_to_matrix(GPIO *io, const HardwareMapping &h,
   // SRAM/SPWM panels should not receive the configuration stream every frame:
   // on some chips those register writes can also leave visible data in SRAM.
   static bool spwm_spwm_init_done = false;
+  // Optional periodic re-init (SPWM_REINIT_MS > 0): the driver chips lose
+  // their configuration when the panel power or the cable glitches while the
+  // Pi keeps running, and stay dark until the registers are written again.
+  {
+    static int spwm_reinit_ms = -1;
+    static struct timespec spwm_last_init = {0, 0};
+    if (spwm_reinit_ms < 0) {
+      int spwm_env_value = 0;
+      spwm_reinit_ms = 0;
+      if (spwm_parse_env_int("SPWM_REINIT_MS", &spwm_env_value) &&
+          spwm_env_value > 0) {
+        spwm_reinit_ms = spwm_env_value;
+      }
+    }
+    if (spwm_reinit_ms > 0) {
+      struct timespec spwm_now;
+      clock_gettime(CLOCK_MONOTONIC, &spwm_now);
+      const int64_t spwm_elapsed_ms =
+          (spwm_now.tv_sec - spwm_last_init.tv_sec) * 1000LL +
+          (spwm_now.tv_nsec - spwm_last_init.tv_nsec) / 1000000LL;
+      if (!spwm_spwm_init_done || spwm_elapsed_ms >= spwm_reinit_ms) {
+        spwm_spwm_init_done = false;
+        spwm_last_init = spwm_now;
+      }
+    }
+  }
   const bool spwm_skip_init =
       spwm_oe_style_init_once(spwm_oe_style) && spwm_spwm_init_done;
   if (!spwm_continuous_scan) {
