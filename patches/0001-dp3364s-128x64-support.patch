-      spwm_group_row = (spwm_group_row + 1) % (64 * 8);
+      spwm_row = (spwm_row + 1) % spwm_get_dp3265s_scan_rows();
+      spwm_group_row = (spwm_group_row + 1) %
+          (spwm_get_dp3265s_groups() * spwm_get_dp3265s_scan_rows());
     }
   }
 
@@ -1766,11 +1797,27 @@ SPWM_Pixel_Block_GPIO_Bits spwm_repack_pixel_block_gpio_bits(
 
   const int spwm_clamped_pwm_bits =
       spwm_pwm_bits > SPWM_WORD_BIT_COUNT ? SPWM_WORD_BIT_COUNT : spwm_pwm_bits;
-  const int spwm_word_bit_base = SPWM_WORD_BIT_COUNT - spwm_clamped_pwm_bits;
+  // SPWM_GRAY_BITS: how many low bits of the 16-bit word the driver actually
+  // displays (e.g. DP3364S with REG03=REG04=0x3F shows 64*64 = 4096 levels,
+  // i.e. 12 bits). The pixel value is MSB-aligned to that width; source bits
+  // that do not fit are dropped from the bottom. Default 16 = previous
+  // behaviour (MSB-aligned to the full word).
+  static int spwm_gray_bits = -1;
+  if (spwm_gray_bits < 0) {
+    int spwm_env_value = 0;
+    spwm_gray_bits = SPWM_WORD_BIT_COUNT;
+    if (spwm_parse_env_int("SPWM_GRAY_BITS", &spwm_env_value) &&
+        spwm_env_value >= 1 && spwm_env_value <= SPWM_WORD_BIT_COUNT) {
+      spwm_gray_bits = spwm_env_value;
+    }
+  }
+  const int spwm_word_bit_base = spwm_gray_bits - spwm_clamped_pwm_bits;
   for (int spwm_source_bit = 0;
        spwm_source_bit < spwm_clamped_pwm_bits;
        ++spwm_source_bit) {
-    spwm_block_gpio_bits.word_gpio_bits[spwm_word_bit_base + spwm_source_bit] =
+    const int spwm_target_bit = spwm_word_bit_base + spwm_source_bit;
+    if (spwm_target_bit < 0) continue;
+    spwm_block_gpio_bits.word_gpio_bits[spwm_target_bit] =
         spwm_pixel_base[spwm_source_bit * spwm_bitplane_stride] & spwm_rgb_mask;
   }
 
